# ===== 本地 / 自建服务器 =====
PORT=8787

# 对外访问地址。Render 会自动使用 RENDER_EXTERNAL_URL，可留空。
# 自建服务器请填写 https://你的域名，否则支付平台无法回调。
PUBLIC_BASE_URL=

# ===== 管理员初始账号（仅首次初始化数据库时写入）=====
ADMIN_USER=ADMIN
# 必填，至少 8 位；不要使用示例值
ADMIN_INITIAL_PASSWORD=

# ===== 易彩豆在线支付 =====
EPAY_GATEWAY=https://pay.521cd.cn/xpay/epay
EPAY_PID=10169
# 必填，商户密钥；不要提交到 Git
EPAY_KEY=
